VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_AI_PROXY_URL=
VITE_YJS_WEBSOCKET_URL=

# OAuth: ONLY the public client_id ships in the client bundle. The client_secret
# is held server-side by the ai-proxy (BFF: /v1/auth/oauth/exchange) via
# GOOGLE_OAUTH_CLIENT_SECRET / GITHUB_OAUTH_CLIENT_SECRET in Secret Manager.
# NEVER add VITE_GOOGLE_CLIENT_SECRET / VITE_GITHUB_CLIENT_SECRET — a secret in a
# distributed binary or public repo is a leaked secret.
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# Billing (Stripe). Build-time flag: "1"/"true" lights the in-app paid menu (PaywallDialog,
# upgrade CTAs, subscription management). Inlined by Vite at BUILD time per release build,
# not runtime-toggleable. Leave unset/0 for a dark (no billing UI) build.
VITE_BILLING_ENABLED=
