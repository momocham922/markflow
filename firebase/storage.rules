rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images: authenticated users can upload to their own folder
    match /images/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Audio archives: authenticated users can upload to their own folder
    match /audio/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // Published HTML pages: authenticated users can write, anyone can read
    match /published/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
